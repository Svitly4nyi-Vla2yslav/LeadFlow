# Local development template. Copy this file to apps/server/.env and replace placeholders locally.
# Never commit real passwords, session secrets, API keys, or customer data.

PORT=3001
ALLOWED_ORIGIN=http://localhost:5173
GOOGLE_API_KEY=
LEADFLOW_DATA_FILE=data/leadflow.json
ADMIN_PASSWORD=replace-with-a-long-unique-password
SESSION_SECRET=replace-with-at-least-32-random-characters
ALLOW_DEV_AUTH_BYPASS=false
VOICE_AGENT_INTEGRATION_TOKEN=
SESSION_HOURS=12
